{"v":15,"id":"a04","kid":"alex","title":"Lunch Time","zh":"午饭时间","level":"1","genre":"食物","src":"original","sum":"中午十二点吃午饭：米饭、鸡肉和四季豆。小作者本来不爱吃四季豆，尝了三根发现还不错。","words":80,"paras":[{"t":"It is twelve o'clock. It is lunch time! I am very hungry.","w":[[0,2,"it",-1],[3,5,"is",-1],[6,12,"twelve",-1],[13,20,"o'clock",-1],[22,24,"it",-1],[25,27,"is",-1],[28,33,"lunch",-1],[34,38,"time",-1],[40,41,"i",-1],[42,44,"am",-1],[45,49,"very",-1],[50,56,"hungry",-1]]},{"t":"Today we have rice, chicken and green beans. I like chicken, but I don't like green beans. Mom says, \"Green beans are good for you.\" So I eat three beans. They are not bad!","w":[[0,5,"today",-1],[6,8,"we",-1],[9,13,"have",-1],[14,18,"rice",-1],[20,27,"chicken",-1],[28,31,"and",-1],[32,37,"green",0],[38,43,"beans",0],[45,46,"i",-1],[47,51,"like",-1],[52,59,"chicken",-1],[61,64,"but",-1],[65,66,"i",-1],[67,72,"don't",-1],[73,77,"like",-1],[78,83,"green",0],[84,89,"beans",0],[91,94,"Mom",-1],[95,99,"says",-1],[102,107,"green",0],[108,113,"beans",0],[114,117,"are",-1],[118,122,"good",1],[123,126,"for",1],[127,130,"you",1],[133,135,"so",-1],[136,137,"i",-1],[138,141,"eat",-1],[142,147,"three",-1],[148,153,"beans",-1],[155,159,"they",-1],[160,163,"are",-1],[164,167,"not",2],[168,171,"bad",2]]},{"t":"For a drink, I have milk. My brother has orange juice. After lunch, we have some fruit. I eat a banana, and my brother eats an apple.","w":[[0,3,"for",-1],[4,5,"a",-1],[6,11,"drink",-1],[13,14,"i",-1],[15,19,"have",-1],[20,24,"milk",-1],[26,28,"my",-1],[29,36,"brother",-1],[37,40,"has",-1],[41,47,"orange",3],[48,53,"juice",3],[55,60,"after",-1],[61,66,"lunch",-1],[68,70,"we",-1],[71,75,"have",-1],[76,80,"some",-1],[81,86,"fruit",-1],[88,89,"i",-1],[90,93,"eat",-1],[94,95,"a",-1],[96,102,"banana",-1],[104,107,"and",-1],[108,110,"my",-1],[111,118,"brother",-1],[119,123,"eats",-1],[124,126,"an",-1],[127,132,"apple",-1]]},{"t":"Now I am full. Thank you, Mom!","w":[[0,3,"now",-1],[4,5,"i",-1],[6,8,"am",-1],[9,13,"full",-1],[15