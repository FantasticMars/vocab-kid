{"v":15,"id":"a09","kid":"alex","title":"The Little Red Hen","zh":"小红母鸡","level":"2","genre":"童话","src":"folk","sum":"改编自英美传统童话。小红母鸡请猫、狗、鸭子帮忙种麦子、做面包，大家都说\"我不\"；面包烤好了，大家都想吃，母鸡却只和小鸡们分享。","words":113,"paras":[{"t":"A little red hen lives on a farm with a cat, a dog and a duck. One day, she finds some wheat seeds.","w":[[0,1,"a",-1],[2,8,"little",-1],[9,12,"red",-1],[13,16,"hen",-1],[17,22,"lives",-1],[23,25,"on",-1],[26,27,"a",-1],[28,32,"farm",-1],[33,37,"with",-1],[38,39,"a",-1],[40,43,"cat",-1],[45,46,"a",-1],[47,50,"dog",-1],[51,54,"and",-1],[55,56,"a",-1],[57,61,"duck",-1],[63,66,"one",3],[67,70,"day",3],[72,75,"she",-1],[76,81,"finds",-1],[82,86,"some",-1],[87,92,"wheat",-1],[93,98,"seeds",-1]]},{"t":"\"Who will help me plant the seeds?\" she asks. \"Not I,\" says the cat. \"Not I,\" says the dog. \"Not I,\" says the duck. So she plants them all by herself.","w":[[1,4,"who",-1],[5,9,"will",-1],[10,14,"help",-1],[15,17,"me",-1],[18,23,"plant",-1],[24,27,"the",-1],[28,33,"seeds",-1],[36,39,"she",-1],[40,44,"asks",-1],[47,50,"Not",0],[51,52,"I",0],[55,59,"says",-1],[60,63,"the",-1],[64,67,"cat",-1],[70,73,"Not",0],[74,75,"I",0],[78,82,"says",-1],[83,86,"the",-1],[87,90,"dog",-1],[93,96,"Not",0],[97,98,"I",0],[101,105,"says",-1],[106,109,"the",-1],[110,114,"duck",-1],[116,118,"so",-1],[119,122,"she",-1],[123,129,"plants",-1],[130,134,"them",-1],[135,138,"all",-1],[139,141,"by",1],[142,149,"herself",1]]},{"t":"The wheat grows tall. \"Who will help me make bread?\" she asks. \"Not I,\" they all say. So she makes the bread by herself.","w":[[0,3,"the",-1],[4,9,"wheat",-1],[10,15,"grows",-1],[16,20,"tall",-1],[23,26,"who",-1],[27,31,"will",-1],[32,36,"help",-1],[37,39,"me",-1],[40,44,"make",-1],[45,50,"bread",-1],[53,56,"she",-1],[57,61,"asks",-1],[64,67,"Not",0],[68,69,"I",0],[72,76,"they",-1],[77,80,"all",-1],[81,84,"say",-1],[86,88,"so",-1],[89,92,"she",-1],[93,98,"makes",-1],[99,102,"the",-1],[103,108,"bread",-1],[109,111,"by",1],[112,119,"herself",1]]},{"t":"The bre